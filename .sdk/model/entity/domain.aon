# Entity: domain

main: kit: entity: domain: {

  alias: field: {}

  fields: [
    {
      name: "age"
      req: false
      short: "Years since first Wayback snapshot"
      type: "`$INTEGER`"
    }
    {
      format: "date-time"
      name: "auction_end_date"
      req: false
      short: "Auction end date and time (ISO 8601)"
      type: "`$STRING`"
    }
    {
      name: "backlinks_count"
      req: false
      short: "Total number of backlinks"
      type: "`$INTEGER`"
    }
    {
      name: "bids_count"
      req: false
      short: "Number of bids"
      type: "`$INTEGER`"
    }
    {
      name: "citation_flow"
      req: false
      short: "Majestic Citation Flow score (0-100)"
      type: "`$INTEGER`"
    }
    {
      name: "domain_authority"
      req: false
      short: "Moz Domain Authority score (0-100)"
      type: "`$INTEGER`"
    }
    {
      name: "edu_gov_backlinks"
      req: false
      short: "Number of EDU/GOV backlinks"
      type: "`$INTEGER`"
    }
    {
      format: "float"
      name: "effective_price"
      req: false
      short: "Effective price (max_bid or price) in EUR"
      type: "`$NUMBER`"
    }
    {
      name: "has_gmb"
      req: false
      short: "Has active Google Business Profile"
      type: "`$BOOLEAN`"
    }
    {
      name: "id"
      req: true
      short: "Unique domain identifier"
      type: "`$INTEGER`"
    }
    {
      name: "language"
      req: false
      short: "Detected content language (e.g., EN, FR, DE)"
      type: "`$STRING`"
    }
    {
      format: "float"
      name: "max_bid"
      req: false
      short: "Current highest bid in EUR"
      type: "`$NUMBER`"
    }
    {
      name: "name"
      req: true
      short: "Domain name"
      type: "`$STRING`"
    }
    {
      name: "pagerank"
      req: false
      short: "Historical PageRank value"
      type: "`$INTEGER`"
    }
    {
      format: "float"
      name: "price"
      req: false
      short: "Starting price or buy-now price in EUR"
      type: "`$NUMBER`"
    }
    {
      format: "uri"
      name: "purchase_url"
      req: false
      short: "Direct URL to purchase or bid on the domain"
      type: "`$STRING`"
    }
    {
      name: "referring_domains"
      req: false
      short: "Number of unique referring domains"
      type: "`$INTEGER`"
    }
    {
      name: "score"
      req: true
      short: "CatchDoms quality score (0-100)"
      type: "`$INTEGER`"
    }
    {
      name: "source"
      req: true
      short: "Platform source (e.g., godaddy, dropcatch, regfree)"
      type: "`$STRING`"
    }
    {
      name: "tld"
      req: true
      short: "Top-level domain extension"
      type: "`$STRING`"
    }
    {
      name: "topical_trust_flow"
      req: false
      short: "Majestic Topical Trust Flow category"
      type: "`$STRING`"
    }
    {
      name: "trust_flow"
      req: false
      short: "Majestic Trust Flow score (0-100)"
      type: "`$INTEGER`"
    }
    {
      name: "type"
      req: false
      short: "Domain listing type"
      type: "`$STRING`"
    }
    {
      format: "date"
      name: "wayback_first_date"
      req: false
      short: "Date of first Wayback snapshot"
      type: "`$STRING`"
    }
    {
      name: "wayback_snapshots"
      req: false
      short: "Number of Wayback Machine snapshots"
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "domain"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "age_min"
                orig: "age_min"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "Business,Health"
                kind: "query"
                name: "category"
                orig: "category"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "cf_min"
                orig: "cf_min"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "contain"
                orig: "contain"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "da_min"
                orig: "da_min"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "has_backlink"
                orig: "has_backlink"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "has_bid"
                orig: "has_bid"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "has_edu_gov"
                orig: "has_edu_gov"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "has_gmb"
                orig: "has_gmb"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "EN"
                kind: "query"
                name: "language"
                orig: "language"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 10
                kind: "query"
                name: "per_page"
                orig: "per_page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "price_max"
                orig: "price_max"
                reqd: false
                type: "`$NUMBER`"
              }
              {
                kind: "query"
                name: "price_min"
                orig: "price_min"
                reqd: false
                type: "`$NUMBER`"
              }
              {
                kind: "query"
                name: "rd_min"
                orig: "rd_min"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "score_min"
                orig: "score_min"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "snapshots_min"
                orig: "snapshots_min"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "source"
                orig: "source"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "tf_min"
                orig: "tf_min"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: ".com"
                kind: "query"
                name: "tld"
                orig: "tld"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "type"
                orig: "type"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/domains"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "domains"
            }
          ]
          select: {
            exist: [
              "age_min"
              "category"
              "cf_min"
              "contain"
              "da_min"
              "has_backlink"
              "has_bid"
              "has_edu_gov"
              "has_gmb"
              "language"
              "page"
              "per_page"
              "price_max"
              "price_min"
              "rd_min"
              "score_min"
              "snapshots_min"
              "source"
              "tf_min"
              "tld"
              "type"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
