# Entity: mcp

main: kit: entity: mcp: {

  alias: field: {}

  fields: [
    {
      name: "capabilities"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "server"
      req: false
      type: "`$STRING`"
    }
    {
      name: "version"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "mcp"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/mcp/catchdoms"
          segments: [
            {
              lit: "mcp"
            }
            {
              lit: "catchdoms"
            }
          ]
          select: {
            "$action": "catchdom"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.capabilities`"
          }
        }
      ]
    }
  }



}
